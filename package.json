{
  "name": "cb-ai-engine",
  "version": "0.1.0",
  "description": "Provider-agnostic, multi-tenant AI engine with database-first config, tool-calling, middleware pipeline, and observability.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs",
      "types": "./dist/providers/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "require": "./dist/middleware/index.cjs",
      "types": "./dist/middleware/index.d.ts"
    },
    "./observability": {
      "import": "./dist/observability/index.js",
      "require": "./dist/observability/index.cjs",
      "types": "./dist/observability/index.d.ts"
    },
    "./dbAdapter": {
      "import": "./dist/dbAdapter/index.js",
      "require": "./dist/dbAdapter/index.cjs",
      "types": "./dist/dbAdapter/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "multi-tenant",
    "provider-agnostic",
    "tool-calling",
    "middleware",
    "observability",
    "database-first"
  ],
  "author": "Pedro Aguirre",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "kysely": "^0.28.20",
    "pg": "^8.23.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "kysely": "^0.28.20"
  }
}
